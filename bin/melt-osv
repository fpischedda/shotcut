#!/usr/bin/env bash
# melt CLI with native DJI Osmo 360 (.OSV) support
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

export OSV_SHADER_PATH="${SCRIPT_DIR}/shaders/osv_stitch.spv"
export MLT_REPOSITORY="${SCRIPT_DIR}/build/plugins"
export MLT_DATA="${SCRIPT_DIR}/build/share/mlt-7"
export FREI0R_PATH="${SCRIPT_DIR}/build/plugins/frei0r:/usr/lib/frei0r-1:/usr/lib64/frei0r-1"

exec /usr/bin/melt "$@"
